# Copy to .env for local development. .env is gitignored — never commit it.
LEGISCAN_API_KEY=your-legiscan-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=od.bill.watch@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: defaults to SMTP_USERNAME
SMTP_FROM=od.bill.watch@gmail.com
# Comma-separated; BCC'd, never logged
RECIPIENTS=friend@example.com,you@example.com
# Mailer backend: smtp (default) | buttondown | console
BILLWATCH_MAILER=smtp
# BUTTONDOWN_API_KEY=...
