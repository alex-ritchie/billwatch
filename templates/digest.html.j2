<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#18181b;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f4f5;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="640" cellspacing="0" cellpadding="0" style="max-width:640px;width:100%;background:#ffffff;border-radius:8px;border:1px solid #e4e4e7;">
<tr><td style="padding:24px 28px 8px 28px;">
  <h1 style="margin:0 0 4px 0;font-size:20px;">{{ feed_title }}</h1>
  <p style="margin:0;color:#52525b;font-size:13px;">Digest for {{ run_date }}
    {%- if session_name %} · {{ session_name }}{% endif %}
    · {{ summary }}</p>
</td></tr>

{% if is_empty %}
<tr><td style="padding:16px 28px 24px 28px;">
  <p style="margin:0;font-size:15px;">Nothing new since the last digest — no new matching bills, no movement on tracked bills, and no hearings in the next {{ lookahead_days }} days.</p>
</td></tr>
{% endif %}

{% macro bill_links(b) -%}
  <a href="{{ b.url }}" style="color:#2563eb;">LegiScan</a>
  {%- if b.state_url %} · <a href="{{ b.state_url }}" style="color:#2563eb;">{{ state_site_label }}</a>{% endif %}
{%- endmacro %}

{% if new_bills %}
<tr><td style="padding:16px 28px 0 28px;">
  <h2 style="margin:0 0 8px 0;font-size:16px;border-bottom:2px solid #e4e4e7;padding-bottom:4px;">🆕 New bills ({{ new_bills|length }})</h2>
  {% for item in new_bills %}{% set b = item.bill %}
  <div style="padding:10px 0;border-bottom:1px solid #f0f0f2;">
    <div style="font-size:15px;"><strong>{{ item.numbers }}</strong>{% if item.partners %} <span style="font-size:11px;color:#71717a;">(cross-filed)</span>{% endif %} — {{ b.title }}</div>
    {% if b.synopsis %}<div style="font-size:13px;color:#3f3f46;margin-top:4px;">{{ b.synopsis|truncate(400) }}</div>{% endif %}
    {% for x in item.bills %}
    <div style="font-size:12px;color:#52525b;margin-top:6px;">
      {% if item.partners %}<strong>{{ x.number }}</strong> · {% endif %}Status: {{ x.status_label }}{% if x.status_date %} ({{ x.status_date }}){% endif %}
      {% if x.committee %} · Committee: {{ x.committee }}{% endif %}
      {% if x.sponsors %} · Sponsors: {{ x.sponsors[:3]|join(', ') }}{% if x.sponsors|length > 3 %} +{{ x.sponsors|length - 3 }}{% endif %}{% endif %}
      · {{ bill_links(x) }}
    </div>
    {% endfor %}
    {% if item.reasons %}<div style="font-size:12px;color:#71717a;margin-top:2px;">Matched: {{ item.reasons|join('; ') }}</div>{% endif %}
  </div>
  {% endfor %}
</td></tr>
{% endif %}

{% if movement %}
<tr><td style="padding:16px 28px 0 28px;">
  <h2 style="margin:0 0 8px 0;font-size:16px;border-bottom:2px solid #e4e4e7;padding-bottom:4px;">🔄 Movement ({{ movement|length }})</h2>
  {% for item in movement %}{% set b = item.bill %}
  <div style="padding:10px 0;border-bottom:1px solid #f0f0f2;">
    <div style="font-size:15px;"><strong>{{ b.number }}</strong> — {{ b.title }}{% if item.partners %} <span style="font-size:11px;color:#71717a;">(cross-filed with {{ item.partners|join(', ') }})</span>{% endif %}</div>
    <div style="font-size:12px;color:#52525b;margin-top:4px;">
      {% if item.status_changed %}Status: {{ item.old_status_label }} → <strong>{{ item.new_status_label }}</strong>{% else %}Status: {{ b.status_label }}{% endif %}
      {% if item.committee_changed %} · Committee: {{ item.old_committee or '—' }} → <strong>{{ item.new_committee or '—' }}</strong>{% elif b.committee %} · Committee: {{ b.committee }}{% endif %}
    </div>
    {% if item.actions %}
    <ul style="margin:6px 0 0 0;padding-left:18px;font-size:13px;color:#3f3f46;">
      {% for a in item.actions %}<li>{{ a.date }} — {{ a.action }}</li>{% endfor %}
    </ul>
    {% endif %}
    <div style="font-size:12px;margin-top:4px;">{{ bill_links(b) }}</div>
  </div>
  {% endfor %}
</td></tr>
{% endif %}

{% if hearings %}
<tr><td style="padding:16px 28px 0 28px;">
  <h2 style="margin:0 0 8px 0;font-size:16px;border-bottom:2px solid #e4e4e7;padding-bottom:4px;">📅 Upcoming hearings — next {{ lookahead_days }} days ({{ hearings|length }})</h2>
  <table role="presentation" cellspacing="0" cellpadding="0" style="width:100%;font-size:13px;">
  {% for item in hearings %}{% set b = item.bill %}{% set h = item.hearing %}
    <tr>
      <td style="padding:6px 8px 6px 0;vertical-align:top;white-space:nowrap;"><strong>{{ h.date }}</strong>{% if h.time %}<br>{{ h.time }}{% endif %}</td>
      <td style="padding:6px 0;vertical-align:top;">
        <strong>{{ b.number }}</strong> — {{ b.title|truncate(120) }}{% if item.partners %} <span style="font-size:11px;color:#71717a;">(cross-filed with {{ item.partners|join(', ') }})</span>{% endif %}<br>
        <span style="color:#52525b;">{{ h.committee }}{% if h.location %} · {{ h.location }}{% endif %}</span><br>
        <span style="font-size:12px;">{{ bill_links(b) }}</span>
      </td>
    </tr>
  {% endfor %}
  </table>
</td></tr>
{% endif %}

{% if watch %}
<tr><td style="padding:16px 28px 0 28px;">
  <h2 style="margin:0 0 8px 0;font-size:16px;border-bottom:2px solid #e4e4e7;padding-bottom:4px;">👀 Committee watch ({{ watch|length }})</h2>
  <p style="margin:0 0 6px 0;font-size:12px;color:#71717a;">Referred to a watched committee but not matched by any keyword — for manual review.</p>
  {% for item in watch %}{% set b = item.bill %}
  <div style="padding:6px 0;border-bottom:1px solid #f0f0f2;font-size:13px;">
    <strong>{{ b.number }}</strong> — {{ b.title|truncate(160) }}
    <span style="color:#52525b;">({{ item.reasons|join('; ') }})</span>
    <span style="font-size:12px;">· {{ bill_links(b) }}</span>
  </div>
  {% endfor %}
</td></tr>
{% endif %}

<tr><td style="padding:20px 28px 24px 28px;">
  <p style="margin:0;font-size:11px;color:#a1a1aa;line-height:1.5;">
    Data from <a href="https://legiscan.com/" style="color:#a1a1aa;">LegiScan</a>. Tracked bills in this feed: {{ tracked_count }}.
    {% if unsubscribe_note %}<br>{{ unsubscribe_note }}{% endif %}
    <br>Sent by billwatch.
  </p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
